function moneyAxis(farthings: number): string {
  const pence = Math.round(farthings / 4);
  if (pence === 0) return '0';
  if (pence % 240 === 0) return `£${pence / 240}`;
  if (pence % 12 === 0) return `${pence / 12}s`;
  return `${pence}d`;
}

function moneyTicks(maxFarthings: number): number[] {
  const max = Math.max(1, maxFarthings / 4);
  const steps = [1, 2, 3, 6, 12, 24, 36, 60, 120, 240, 480, 1200, 2400, 4800, 12000];
  const step = steps.find((s) => max / s <= 4.2) ?? 24000;
  const out: number[] = [];
  for (let v = 0; ; v += step) {
    out.push(v * 4);
    if (v >= max) break;
  }
  return out;
}

const ROMAN: [number, string][] = [
  [1000, 'm'],
  [900, 'cm'],
  [500, 'd'],
  [400, 'cd'],
  [100, 'c'],
  [90, 'xc'],
  [50, 'l'],
  [40, 'xl'],
  [10, 'x'],
  [9, 'ix'],
  [5, 'v'],
  [4, 'iiii'],
  [1, 'i'],
];

function roman(n: number): string {
  let v = Math.floor(n);
  let out = '';
  for (const [k, s] of ROMAN) {
    while (v >= k) {
      out += s;
      v -= k;
    }
  }
  return out.replace(/i$/, 'j');
}

function clerkSum(farthings: number): string {
  const { l, s, d, q } = splitMoney(farthings);
  const bits: string[] = [];
  if (l) bits.push(`${roman(l)} li.`);
  if (s) bits.push(`${roman(s)} s.`);
  if (d) bits.push(`${roman(d)} d.`);
  if (q >= 2) bits.push('ob.');
  if (q % 2 === 1) bits.push('q.');
  return bits.length ? bits.join(' ') : 'nichil';
}

function grainParts(bushels: number): Part[] {
  const b = Math.max(0, Math.round(bushels));
  const q = Math.floor(b / 8);
  const r = b % 8;
  const parts: Part[] = [];
  if (q > 0) parts.push({ n: fmtInt(q), u: 'qr', gap: true });
  if (r > 0 || q === 0) parts.push({ n: String(r), u: 'bu', gap: true });
  return parts;
}

function niceTicks(max: number, count = 5): number[] {
  const m = Math.max(1, max);
  const raw = m / count;
  const mag = 10 ** Math.floor(Math.log10(raw));
  const norm = raw / mag;
  const step = Math.max(1, Math.round((norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 5 ? 5 : 10) * mag));
  const out: number[] = [];
  for (let v = 0; ; v += step) {
    out.push(v);
    if (v >= m) break;
  }
  return out;
}

const clamp = (v: number, lo: number, hi: number): number => Math.min(hi, Math.max(lo, v));

function resample(src: number[], n: number): number[] {
  if (src.length === n) return src;
  const out = new Array<number>(n).fill(0);
  if (src.length === 0 || n === 0) return out;
  if (n === 1 || src.length === 1) return out.fill(src[src.length - 1]);
  const k = (src.length - 1) / (n - 1);
  for (let i = 0; i < n; i++) {
    const p = i * k;
    const j = Math.floor(p);
    out[i] = j + 1 < src.length ? src[j] + (src[j + 1] - src[j]) * (p - j) : src[src.length - 1];
  }
  return out;
}

const r1 = (v: number) => Math.round(v * 10) / 10;

function linePath(xs: number[], ys: number[]): string {
  const n = xs.length;
  if (n === 0) return '';
  let p = `M${r1(xs[0])},${r1(ys[0])}`;
  if (n === 1) return p;

  if (n > 150) {
    for (let i = 1; i < n; i++) p += `L${r1(xs[i])},${r1(ys[i])}`;
    return p;
  }

  const d = new Array<number>(n - 1);
  const m = new Array<number>(n);
  for (let i = 0; i < n - 1; i++) d[i] = (ys[i + 1] - ys[i]) / (xs[i + 1] - xs[i] || 1);
  m[0] = d[0];
  m[n - 1] = d[n - 2];
  for (let i = 1; i < n - 1; i++) m[i] = d[i - 1] * d[i] <= 0 ? 0 : (d[i - 1] + d[i]) / 2;
  for (let i = 0; i < n - 1; i++) {
    if (d[i] === 0) {
      m[i] = 0;
      m[i + 1] = 0;
      continue;
    }
    const a = m[i] / d[i];
    const b = m[i + 1] / d[i];
    const s = a * a + b * b;
    if (s > 9) {
      const t = 3 / Math.sqrt(s);
      m[i] = t * a * d[i];
      m[i + 1] = t * b * d[i];
    }
  }
  for (let i = 0; i < n - 1; i++) {
    const h = (xs[i + 1] - xs[i]) / 3;
    p += `C${r1(xs[i] + h)},${r1(ys[i] + m[i] * h)} ${r1(xs[i + 1] - h)},${r1(ys[i + 1] - m[i + 1] * h)} ${r1(xs[i + 1])},${r1(ys[i + 1])}`;
  }
  return p;
}

interface LabelIn {
  x: number;
  label: string;
  rank: number;
}

interface LabelOut extends LabelIn {
  anchor: 'start' | 'middle' | 'end';
  dx: number;
}

function placeLabels(items: LabelIn[], width: number, charWidth = 6.2, pad = 8): LabelOut[] {
  const boxes: [number, number][] = [];
  const out: LabelOut[] = [];
  const clear = (x0: number, w: number) => !boxes.some(([a, b]) => x0 < b + pad && x0 + w > a - pad);

  for (const it of [...items].sort((a, b) => a.rank - b.rank || a.x - b.x)) {
    const w = it.label.length * charWidth;
    let anchor: LabelOut['anchor'] = 'middle';
    let x0 = it.x - w / 2;
    if (x0 < 0) {
      anchor = 'start';
      x0 = 0;
    } else if (x0 + w > width) {
      anchor = 'end';
      x0 = width - w;
    }

    let dx = 0;
    if (!clear(x0, w)) {
      const nudge =
        anchor === 'middle'
          ? [-6, 6, -12, 12].find((d) => x0 + d >= 0 && x0 + d + w <= width && clear(x0 + d, w))
          : undefined;
      if (nudge === undefined) continue;
      dx = nudge;
    }
    boxes.push([x0 + dx, x0 + dx + w]);
    out.push({ ...it, anchor, dx });
  }
  return out;
}

function usePrefersReducedMotion(): boolean {
  const [reduced, setReduced] = useState(() => window.matchMedia('(prefers-reduced-motion: reduce)').matches);
  useEffect(() => {
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sync = () => setReduced(mq.matches);
    mq.addEventListener('change', sync);
    return () => mq.removeEventListener('change', sync);
  }, []);
  return reduced;
}

function useTweenSeries(target: number[][], opts: { duration?: number; grow?: boolean } = {}): number[][] {
  const { duration = 450, grow = true } = opts;
  const reduced = usePrefersReducedMotion();
  const shown = useRef<number[][] | null>(null);
  if (shown.current === null) {
    shown.current = grow && !reduced ? target.map((s) => s.map(() => 0)) : target;
  }
  const [, bump] = useState(0);

  useEffect(() => {
    const start = shown.current ?? [];
    const from = target.map((s, k) => resample(start[k] ?? [], s.length));
    const settled = from.every((f, k) => f.every((v, i) => v === target[k][i]));
    if (reduced || settled) {
      if (shown.current !== target) {
        shown.current = target;
        bump((n) => n + 1);
      }
      return;
    }

    let raf = 0;
    const t0 = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - t0) / duration);
      const e = 1 - (1 - t) ** 3;
      shown.current = t >= 1 ? target : target.map((s, k) => s.map((v, i) => from[k][i] + (v - from[k][i]) * e));
      bump((n) => n + 1);
      if (t < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, [target, duration, reduced]);

  return shown.current;
}

function useWidth<T extends HTMLElement>() {
  const ref = useRef<T>(null);
  const [width, setWidth] = useState(0);
  useLayoutEffect(() => {
    const el = ref.current;
    if (!el) return;
    setWidth(el.getBoundingClientRect().width);
    const ro = new ResizeObserver(([entry]) => setWidth(entry.contentRect.width));
    ro.observe(el);
    return () => ro.disconnect();
  }, []);
  return [ref, Math.round(width)] as const;
}

function useMounted(): boolean {
  const [on, setOn] = useState(false);
  useEffect(() => {
    const id = requestAnimationFrame(() => setOn(true));
    return () => cancelAnimationFrame(id);
  }, []);
  return on;
}

function useDebounced<T>(value: T, ms: number): T {
  const [settled, setSettled] = useState(value);
  useEffect(() => {
    const id = window.setTimeout(() => setSettled(value), ms);
    return () => window.clearTimeout(id);
  }, [value, ms]);
  return settled;
}

type Theme = 'light' | 'dark';

function useTheme(): [Theme, (t: Theme) => void] {
  const [theme, setTheme] = useState<Theme>(() =>
    document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light',
  );

  useEffect(() => {
    const root = document.documentElement;
    if (root.dataset.theme) return;
    const prefers = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    root.dataset.theme = prefers;
    setTheme(prefers);
  }, []);

  const choose = useCallback((t: Theme) => {
    const root = document.documentElement;
    root.classList.add('srf-theme-anim');
    root.dataset.theme = t;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'dark' ? '#141310' : '#f3f1eb');
    try {
      localStorage.setItem('serf-theme', t);
    } catch {
    }
    window.setTimeout(() => root.classList.remove('srf-theme-anim'), 350);
    setTheme(t);
  }, []);

  return [theme, choose];
}

