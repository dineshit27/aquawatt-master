function splitMoney(farthings: number) {
  const f = Math.max(0, Math.round(farthings));
  const pence = Math.floor(f / 4);
  return { l: Math.floor(pence / 240), s: Math.floor((pence % 240) / 12), d: pence % 12, q: f % 4 };
}

function moneyParts(farthings: number): Part[] {
  const { l, s, d, q } = splitMoney(farthings);
  const hasPence = d > 0 || q > 0;
  const parts: Part[] = [];
  if (l > 0) parts.push({ n: `£${fmtInt(l)}` });
  if (s > 0 || (l > 0 && hasPence)) parts.push({ n: String(s), u: 's' });
  if (hasPence) parts.push({ n: `${d > 0 ? d : ''}${FRACTION[q]}`, u: 'd' });
  if (!parts.length) parts.push({ n: '0', u: 'd' });
  return parts;
}

