      <div className="srf-tip-foot">
        Change
        <Delta cur={item.cur} prev={item.prev} />
      </div>
    </>
  );
}

const TRACK = 52;
const MIN_SPAN = 7;
const RIBBON_MARKS = YEAR_FEASTS.filter((f) => f.rank <= 3);

const MONTH_STARTS: { off: number; m: number; y: number }[] = [];
for (let d = FIRST_DAY; d <= LAST_DAY; d++) {
  if (d === FIRST_DAY || DAYS[d].d === 1) MONTH_STARTS.push({ off: d - FIRST_DAY, m: DAYS[d].m, y: DAYS[d].y });
}

type Mode = 'start' | 'end' | 'pan';

function YearRibbon({ from, to, shape, onChange }: { from: number; to: number; shape: number[]; onChange: (f: number, t: number) => void }) {
  const [ref, width] = useWidth<HTMLDivElement>();
  const drag = useRef<{ mode: Mode; grab: number; span: number } | null>(null);
  const [dragging, setDragging] = useState(false);

  const a = from - FIRST_DAY;
  const b = to - FIRST_DAY;
  const px = (off: number) => (off / YEAR_DAYS) * width;
  const left = px(a);
  const selWidth = px(b + 1) - left;

  const target = useMemo(() => [shape], [shape]);
  const [anim] = useTweenSeries(target);
  const peak = Math.max(1, ...anim);
  const area =
    `M0,${TRACK}` +
    anim
      .map((v, i) => `L${(((i + 0.5) / anim.length) * width).toFixed(1)},${(TRACK - 3 - (v / peak) * (TRACK - 13)).toFixed(1)}`)
      .join('') +
    `L${width},${TRACK}Z`;

  const labels = useMemo(
    () =>
      placeLabels(
        RIBBON_MARKS.map((f) => ({ x: ((f.day - FIRST_DAY + 0.5) / YEAR_DAYS) * width, label: f.name, rank: f.rank })),
        width,
      ),
    [width],
  );

  const dayAt = (clientX: number) => {
    const box = ref.current?.getBoundingClientRect();
    if (!box) return 0;
    return clamp(Math.floor(((clientX - box.left) / box.width) * YEAR_DAYS), 0, YEAR_DAYS - 1);
  };

  const begin = (mode: Mode) => (e: PointerEvent<HTMLDivElement>) => {
    if (e.button !== 0) return;
    e.stopPropagation();
    e.currentTarget.setPointerCapture(e.pointerId);
    drag.current = { mode, grab: dayAt(e.clientX) - (mode === 'end' ? b : a), span: b - a };
    setDragging(true);
  };

  const jump = (e: PointerEvent<HTMLDivElement>) => {
    if (e.button !== 0 || e.pointerType === 'touch') return;
    const span = b - a;
    const day = dayAt(e.clientX);
    const start = clamp(day - Math.floor(span / 2), 0, YEAR_DAYS - 1 - span);
    e.currentTarget.setPointerCapture(e.pointerId);
    drag.current = { mode: 'pan', grab: day - start, span };
    setDragging(true);
    if (start !== a) onChange(FIRST_DAY + start, FIRST_DAY + start + span);
  };

  const move = (e: PointerEvent<HTMLDivElement>) => {
    const d = drag.current;
    if (!d) return;
    const day = dayAt(e.clientX) - d.grab;
    if (d.mode === 'start') {
      const next = clamp(day, 0, b - MIN_SPAN + 1);
      if (next !== a) onChange(FIRST_DAY + next, to);
    } else if (d.mode === 'end') {
      const next = clamp(day, a + MIN_SPAN - 1, YEAR_DAYS - 1);
      if (next !== b) onChange(from, FIRST_DAY + next);
    } else {
      const next = clamp(day, 0, YEAR_DAYS - 1 - d.span);
      if (next !== a) onChange(FIRST_DAY + next, FIRST_DAY + next + d.span);
    }
  };

  const release = () => {
    drag.current = null;
    setDragging(false);
  };

  const onKey = (which: 'start' | 'end') => (e: KeyboardEvent<HTMLDivElement>) => {
    const steps: Record<string, number> = {
      ArrowLeft: -1,
      ArrowDown: -1,
      ArrowRight: 1,
      ArrowUp: 1,
      PageDown: -30,
      PageUp: 30,
      Home: -YEAR_DAYS,
      End: YEAR_DAYS,
    };
    let step = steps[e.key];
    if (!step) return;
    e.preventDefault();
    if (e.shiftKey && Math.abs(step) === 1) step *= 7;
    if (which === 'start') onChange(FIRST_DAY + clamp(a + step, 0, b - MIN_SPAN + 1), to);
    else onChange(from, FIRST_DAY + clamp(b + step, a + MIN_SPAN - 1, YEAR_DAYS - 1));
  };

  const glide = !dragging ? ' glide' : '';

  const handle = (which: 'start' | 'end') => (
    <div
      role="slider"
      tabIndex={0}
      aria-label={which === 'start' ? 'First day of the period' : 'Last day of the period'}
      aria-orientation="horizontal"
      aria-valuemin={which === 'start' ? 0 : a + MIN_SPAN - 1}
      aria-valuemax={which === 'start' ? b - MIN_SPAN + 1 : YEAR_DAYS - 1}
      aria-valuenow={which === 'start' ? a : b}
      aria-valuetext={fmtDay(which === 'start' ? from : to, { weekday: true, year: true })}
      onKeyDown={onKey(which)}
      onPointerDown={begin(which)}
      className={`srf-handle${glide}`}
      style={{ transform: `translateX(${which === 'start' ? left : left + selWidth}px)` }}
    >
      <span className="srf-grip" />
    </div>
  );

  const wide = width >= 620;

  return (
    <div className="srf-ribbon">
      <div className="srf-feasts" aria-hidden="true">
        {labels.map((l) => (
          <span
            key={`${l.label}-${l.x}`}
            className={`srf-feast${l.anchor === 'middle' ? ' mid' : ''}${l.rank <= 1 ? ' q' : ''}`}
            style={l.anchor === 'end' ? { right: 0 } : { left: l.anchor === 'start' ? 0 : l.x + l.dx }}
          >
            {l.label}
          </span>
        ))}
      </div>

      <div
        ref={ref}
        className="srf-track"
        style={{ height: TRACK }}
        onPointerDown={jump}
        onPointerMove={move}
        onPointerUp={release}
        onPointerCancel={release}
        onLostPointerCapture={release}
      >
        {width > 0 && (
          <>
            <svg width={width} height={TRACK} className="srf-layer" aria-hidden="true">
              <path d={area} className="srf-ribbon-dim" />
            </svg>

            <div onPointerDown={begin('pan')} className={`srf-sel${glide}`} style={{ width: selWidth, transform: `translateX(${left}px)` }}>
              <svg width={width} height={TRACK} className={`srf-sel-svg${glide}`} style={{ transform: `translateX(${-left}px)` }} aria-hidden="true">
                <path d={area} className="srf-ribbon-lit" />
              </svg>
              <span className="srf-sel-ring" />
            </div>

            <svg width={width} height={TRACK} className="srf-marks" aria-hidden="true">
              {MONTH_STARTS.map((m) => (
                <line key={m.off} x1={px(m.off)} x2={px(m.off)} y1={TRACK - 5} y2={TRACK} className="srf-month-tick" />
              ))}
              {RIBBON_MARKS.map((f) => {
                const x = px(f.day - FIRST_DAY + 0.5);
                return (
                  <g key={`${f.name}-${f.day}`}>
                    <line x1={x} x2={x} y1={0} y2={TRACK} className="srf-feast-rule" />
                    <rect x={x - 3} y={-3} width={6} height={6} transform={`rotate(45 ${x} 0)`} className="srf-feast-gem" />
                  </g>
                );
              })}
            </svg>

            {handle('start')}
            {handle('end')}
          </>
        )}
      </div>

      <div className="srf-months" aria-hidden="true">
        {MONTH_STARTS.map((m, i) => {
          const next = MONTH_STARTS[i + 1]?.off ?? YEAR_DAYS;
          const name = MONTHS[m.m - 1];
          const space = px(next - m.off);
          const label = !wide ? name[0] : m.m === 1 && width >= 900 && space >= 52 ? `${name} ${m.y}` : name;
          if (space < label.length * 6 + 2) return null;
          return (
            <span
              key={m.off}
              className="srf-month"
              style={{ left: px((m.off + next) / 2) }}
            >
              {label}
            </span>
          );
        })}
      </div>
    </div>
  );
}

const selectableHarvestYear = latestYearFor(8, MIN_SPAN);
const PRESETS = [
  { label: 'Full year', from: FIRST_DAY, to: LAST_DAY, hint: 'Last 12 months, including today' },
  { label: 'Half year', from: trailingStart(6), to: LAST_DAY, hint: 'Last 6 months, including today' },
  { label: 'Quarter', from: trailingStart(3), to: LAST_DAY, hint: 'Last 3 months, including today' },
  {
    label: 'Harvest',
    from: Math.max(FIRST_DAY, dayIndex(selectableHarvestYear, 8, 1)),
    to: Math.min(LAST_DAY, dayIndex(selectableHarvestYear, 9, 29)),
    hint: 'Most recent available harvest in the reporting period',
  },
  { label: '30 days', from: LAST_DAY - 29, to: LAST_DAY, hint: 'Last 30 days, including today' },
];

const COUNTS = TENURES.map((_, i) => HOUSEHOLDS.filter((h) => h.tenure === i).length);

interface RangeProps {
  from: number;
  to: number;
  onRange: (from: number, to: number) => void;
}

interface SegProps {
  segs: number[];
  onSegs: (segs: number[]) => void;
}

function PeriodPresets({ from, to, onRange }: RangeProps) {
  return (
    <div role="group" aria-label="Period" className="srf-seg">
      {PRESETS.map((p) => (
        <button
          key={p.label}
          type="button"
          title={p.hint}
          aria-pressed={from === p.from && to === p.to}
          onClick={() => onRange(p.from, p.to)}
        >
          {p.label}
        </button>
      ))}
    </div>
  );
}

function TenantChips({ segs, onSegs }: SegProps) {
  const toggle = (i: number) => {
    const next = segs.includes(i) ? segs.filter((s) => s !== i) : [...segs, i].sort();
    onSegs(next.length === TENURES.length ? [] : next);
  };

  return (
    <div role="group" aria-label="Tenants" className="srf-chips">
      <button type="button" aria-pressed={segs.length === 0} onClick={() => onSegs([])} className="srf-chip">
        All
        <span className="srf-chip-n">{HOUSEHOLDS.length}</span>
      </button>
      {TENURES.map((t, i) => (
        <button
          key={t.label}
          type="button"
          title={t.note}
          aria-pressed={segs.includes(i)}
          onClick={() => toggle(i)}
          className={`srf-chip${segs.includes(i) ? ' on' : ''}`}
        >
          {segs.includes(i) && <CheckIcon />}
          {t.label}
          <span className="srf-chip-n">{COUNTS[i]}</span>
        </button>
      ))}
    </div>
  );
}

function FilterPanel({ from, to, segs, shape, onRange, onSegs }: RangeProps & SegProps & { shape: number[] }) {
  const changed = from !== FIRST_DAY || to !== LAST_DAY || segs.length > 0;
  const days = to - from + 1;

  return (
    <section aria-label="Filters" className="srf-card srf-pad srf-reveal" style={{ '--i': 1 } as CSSProperties}>
      <div className="srf-filters-top">
        <div className="srf-field">
          <p className="srf-flabel">Period</p>
          <div className="srf-xscroll">
            <PeriodPresets from={from} to={to} onRange={onRange} />
          </div>
        </div>
        <div className="srf-field">
          <p className="srf-flabel">Tenants</p>
          <TenantChips segs={segs} onSegs={onSegs} />
        </div>
      </div>

      <div className="srf-range-line">
        <p>
          <strong className="srf-range">{fmtRange(from, to)}</strong>
          <span> · {days} days, set against the same dates a year before</span>
        </p>
        {changed && (
          <button
            type="button"
            onClick={() => {
              onRange(FIRST_DAY, LAST_DAY);
              onSegs([]);
            }}
            className="srf-reset"
          >
            Reset filters
          </button>
        )}
      </div>

      <div className="srf-ribbon-wrap">
        <YearRibbon from={from} to={to} shape={shape} onChange={onRange} />
      </div>
      <p className="srf-hint">Drag either handle to change the period, or drag the lit window to move it.</p>
    </section>
  );
}

function SlimFilters({ from, to, segs, onRange, onSegs }: RangeProps & SegProps) {
  return (
    <div className="srf-slim">
      <div className="srf-slim-in">
        <p className="srf-slim-range">{fmtRange(from, to)}</p>
        <PeriodPresets from={from} to={to} onRange={onRange} />
        <span aria-hidden="true" className="srf-vr" />
        <TenantChips segs={segs} onSegs={onSegs} />
      </div>
    </div>
  );
}

function Spark({ values, lit }: { values: number[]; lit: boolean }) {
  const target = useMemo(() => [resample(values, 48)], [values]);
  const [shown] = useTweenSeries(target);
  const peak = Math.max(1e-6, ...shown);
  const xs = shown.map((_, i) => (i / (shown.length - 1)) * 100);
  const ys = shown.map((v) => 30 - (v / peak) * 26);
  const line = linePath(xs, ys);
  return (
    <svg viewBox="0 0 100 32" preserveAspectRatio="none" className={`srf-spark${lit ? ' lit' : ''}`} aria-hidden="true">
      <path d={`${line}L100,32L0,32Z`} className="srf-spark-fill" />
      <path d={line} className="srf-spark-line" vectorEffect="non-scaling-stroke" />
    </svg>
  );
}

function Kpi({
  id,
  index,
  view,
  context,
  selected,
  onSelect,
}: {
  id: MetricId;
  index: number;
  view: View;
  context: string;
  selected: boolean;
  onSelect: (id: MetricId) => void;
}) {
  const cfg = METRICS[id];
  const { cur, prev } = view.totals[id];
  const target = useMemo(() => [[cur]], [cur]);
  const [[shown]] = useTweenSeries(target);

  return (
    <button
      type="button"
      aria-pressed={selected}
      onClick={() => onSelect(id)}
      style={{ '--i': index + 2 } as CSSProperties}
      className={`srf-kpi srf-reveal${selected ? ' on' : ''}`}
    >
      <span className="srf-kpi-top">
        <span className="srf-kpi-label">{cfg.label}</span>
        <span aria-hidden="true" className={`srf-kpi-radio${selected ? ' on' : ''}`}>
          <span className="srf-kpi-radio-dot" />
        </span>
      </span>

      <span className="srf-kpi-value">
        <Parts parts={cfg.parts(shown)} />
      </span>

      <span className="srf-kpi-foot">
        <Delta cur={cur} prev={prev} invert={cfg.invert} />
        <span>{context}</span>
      </span>

      <Spark values={view.rolling[id].cur} lit={selected} />
      <span className="srf-sr">{selected ? 'Shown in the chart below.' : 'Show in the chart below.'}</span>
    </button>
  );
}

function KpiRow({ view, metric, onSelect }: { view: View; metric: MetricId; onSelect: (id: MetricId) => void }) {
  const { totals, owed, rows, days } = view;
  const context: Record<MetricId, string> = {
    works: `of ${fmtInt(owed.cur)} owed`,
    missed: owed.cur > 0 ? `${fmtPct(totals.missed.cur / owed.cur)} of works owed` : 'none fell due',
    dues: rows.length ? `${fmtMoney(totals.dues.cur / rows.length)} a household` : '',
    grain: `${fmtInt((totals.grain.cur / days) * 7)} bu a week`,
  };

  return (
    <section aria-label="Key figures. Choose one to chart it." className="srf-kpis">
      {METRIC_ORDER.map((id, i) => (
        <Kpi key={id} id={id} index={i} view={view} context={context[id]} selected={metric === id} onSelect={onSelect} />
      ))}
    </section>
  );
}

interface Tick {
  i: number;
  label: string;
}

function dateTicks(from: number, n: number, innerWidth: number): Tick[] {
  const all: Tick[] = [];
  for (let i = 0; i < n; i++) {
    const { d, m, y, dow } = DAYS[from + i];
    const mon = MONTHS[m - 1];
    if (n > 110) {
      if (d === 1) all.push({ i, label: m === 1 ? `${mon} ${y}` : mon });
    } else if (n > 45) {
      if (d === 1 || d === 15) all.push({ i, label: `${d} ${mon}` });
    } else if (n > 14) {
      if (dow === 1) all.push({ i, label: `${d} ${mon}` });
    } else {
      all.push({ i, label: `${d} ${mon}` });
    }
  }
  const kept: Tick[] = [];
  let lastX = -Infinity;
  for (const t of all) {
    const x = n > 1 ? (t.i / (n - 1)) * innerWidth : 0;
    if (x - lastX < 62) continue;
    kept.push(t);
    lastX = x;
  }
  return kept;
}

function TrendChart({ metric, cur, prev, from }: { metric: MetricId; cur: number[]; prev: number[]; from: number }) {
  const cfg = METRICS[metric];
  const uid = useId().replace(/[^a-zA-Z0-9]/g, '');
  const [ref, width] = useWidth<HTMLDivElement>();
  const compact = width < 560;
  const height = compact ? 250 : 330;
  const m = { t: 26, r: 10, b: 30, l: compact ? 38 : 48 };
  const iw = Math.max(40, width - m.l - m.r);
  const ih = height - m.t - m.b;
  const base = m.t + ih;
  const n = cur.length;

  const peak = useMemo(() => Math.max(...cur, ...prev), [cur, prev]);
  const ticks = useMemo(() => cfg.ticks(peak), [cfg, peak]);
  const top = ticks[ticks.length - 1];

  const seriesTarget = useMemo(() => [cur, prev], [cur, prev]);
  const topTarget = useMemo(() => [[top]], [top]);
  const [aCur, aPrev] = useTweenSeries(seriesTarget);
  const [[aTop]] = useTweenSeries(topTarget, { grow: false });
  const yMax = Math.max(aTop, 1e-6);

  const px = (i: number, len: number) => m.l + (len > 1 ? (i / (len - 1)) * iw : iw / 2);
  const py = (v: number) => base - (Math.max(0, v) / yMax) * ih;

  const line = linePath(
    aCur.map((_, i) => px(i, aCur.length)),
    aCur.map(py),
  );
  const area = line ? `${line}L${m.l + iw},${base}L${m.l},${base}Z` : '';
  const ghost = linePath(
    aPrev.map((_, i) => px(i, aPrev.length)),
    aPrev.map(py),
  );

  const xTicks = useMemo(() => dateTicks(from, n, iw), [from, n, iw]);
  const feasts = useMemo(() => {
    const inRange = YEAR_FEASTS.filter((f) => f.rank <= 3 && f.day >= from && f.day <= from + n - 1).map((f) => ({
      x: n > 1 ? ((f.day - from) / (n - 1)) * iw : 0,
      label: f.name,
      rank: f.rank,
    }));
    return { all: inRange, labelled: placeLabels(inRange, iw) };
  }, [from, n, iw]);

  const [hover, setHover] = useState<number | null>(null);
  const lastHover = useRef(n - 1);
  if (hover !== null) lastHover.current = hover;
  const hi = clamp(lastHover.current, 0, n - 1);
  const day = from + hi;
  const feast = FEAST_NAME.get(day);

  const hideTimer = useRef(0);
  useEffect(() => () => window.clearTimeout(hideTimer.current), []);

  const scrub = (e: PointerEvent<SVGRectElement>) => {
    window.clearTimeout(hideTimer.current);
    const box = e.currentTarget.getBoundingClientRect();
    setHover(clamp(Math.round(((e.clientX - box.left) / box.width) * (n - 1)), 0, n - 1));
  };

  const leave = (e: PointerEvent<SVGRectElement>) => {
    window.clearTimeout(hideTimer.current);
    if (e.pointerType === 'touch') hideTimer.current = window.setTimeout(() => setHover(null), 2600);
    else setHover(null);
  };

  const onKey = (e: KeyboardEvent<HTMLDivElement>) => {
    if (e.key === 'Escape') return setHover(null);
    const steps: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1, Home: -n, End: n };
    const step = steps[e.key];
    if (!step) return;
    e.preventDefault();
    setHover(clamp((hover ?? n - 1) + (e.shiftKey && Math.abs(step) === 1 ? step * 7 : step), 0, n - 1));
  };

  const onFocus = (e: FocusEvent<HTMLDivElement>) => {
    if (e.currentTarget.matches(':focus-visible')) setHover((h) => h ?? n - 1);
  };

  const summary = `${cfg.chart}, ${fmtDay(from, { year: true })} to ${fmtDay(from + n - 1, { year: true })}. The busiest seven days: ${cfg.short(Math.max(...cur))}.`;

  return (
    <div ref={ref} className="srf-chart">
      {width > 0 && (
        <div
          role="group"
          tabIndex={0}
          aria-label={`${summary} Use the left and right arrow keys to read it day by day.`}
          onKeyDown={onKey}
          onFocus={onFocus}
          onBlur={() => setHover(null)}
          className="srf-chart-box"
        >
          <svg width={width} height={height} className="srf-svg" aria-hidden="true">
            <defs>
              <linearGradient id={`srf-fill-${uid}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stopColor="var(--srf-accent)" stopOpacity="0.2" />
                <stop offset="100%" stopColor="var(--srf-accent)" stopOpacity="0" />
              </linearGradient>
              <clipPath id={`srf-clip-${uid}`}>
                <rect x={m.l - 2} y={m.t - 6} width={iw + 4} height={ih + 7} />
              </clipPath>
            </defs>

            {ticks.map((t) => {
              const y = py(t);
              if (y < m.t - 1) return null;
              return (
                <g key={t}>
                  <line x1={m.l} x2={m.l + iw} y1={y} y2={y} className={t === 0 ? 'srf-grid0' : 'srf-grid'} />
                  <text x={m.l - 8} y={y} dy="0.32em" textAnchor="end" className="srf-ylab">
                    {cfg.axis(t)}
                  </text>
                </g>
              );
            })}

            {feasts.all.map((f) => (
              <g key={`${f.label}-${f.x}`}>
                <line x1={m.l + f.x} x2={m.l + f.x} y1={m.t - 4} y2={base} className="srf-feast-rule" />
                <rect x={m.l + f.x - 2.5} y={base - 2.5} width={5} height={5} transform={`rotate(45 ${m.l + f.x} ${base})`} className="srf-feast-gem" />
              </g>
            ))}
            {feasts.labelled.map((f) => (
              <text
                key={`${f.label}-${f.x}`}
                x={m.l + (f.anchor === 'start' ? 0 : f.anchor === 'end' ? iw : f.x + f.dx)}
                y={m.t - 11}
                textAnchor={f.anchor}
                className={`srf-flab${f.rank <= 1 ? ' q' : ''}`}
              >
                {f.label}
              </text>
            ))}

            {xTicks.map((t) => (
              <text key={t.i} x={px(t.i, n)} y={base + 19} textAnchor="middle" className="srf-xlab">
                {t.label}
              </text>
            ))}

            <g clipPath={`url(#srf-clip-${uid})`}>
              <path d={area} fill={`url(#srf-fill-${uid})`} />
              <path d={ghost} className="srf-ghost" />
              <path d={line} className="srf-line" />
            </g>

            <g className={`srf-readout${hover === null ? ' off' : ''}`}>
              <line x1={px(hi, n)} x2={px(hi, n)} y1={m.t} y2={base} className="srf-cross" />
              <circle cx={px(hi, n)} cy={py(prev[hi])} r={3.5} className="srf-ptp" />
              <circle cx={px(hi, n)} cy={py(cur[hi])} r={4.5} className="srf-ptc" />
            </g>

            <rect x={m.l} y={m.t} width={iw} height={ih} fill="transparent" className="srf-hit" onPointerDown={scrub} onPointerMove={scrub} onPointerLeave={leave} />
          </svg>

          {peak === 0 && <p className="srf-empty">{cfg.empty}</p>}
        </div>
      )}

      <ChartTip show={hover !== null} x={px(hi, n)} y={compact ? m.t - 8 : m.t} boxWidth={width} above={compact} center={compact}>
        <p className="srf-tip-k">Seven days to</p>
        <p className="srf-tip-title">{fmtDay(day, { weekday: true, year: true })}</p>
        {feast && <p className="srf-tip-feast">{feast}</p>}
        <div className="srf-tip-grid srf-tip-cols">
          <span className="srf-sw-line" />
          <span>This year</span>
          <span className="srf-tip-num">{cfg.short(cur[hi])}</span>
          <span className="srf-sw-dash" />
          <span>Year before</span>
          <span>{cfg.short(prev[hi])}</span>
        </div>
        <div className="srf-tip-foot">
          Change
          <Delta cur={cur[hi]} prev={prev[hi]} invert={cfg.invert} />
        </div>
      </ChartTip>

      <p className="srf-sr" aria-live="polite">
        {hover !== null &&
          `Seven days to ${fmtDay(day, { weekday: true })}${feast ? `, ${feast}` : ''}: ${cfg.short(cur[hi])} this year, ${cfg.short(prev[hi])} the year before.`}
      </p>
    </div>
  );
}

const SIZE = 220;
const C = SIZE / 2;
const R_OUT = 100;
const R_IN = 69;
const TAU = Math.PI * 2;

function sector(a0: number, a1: number, rOut: number): string {
  const large = a1 - a0 > Math.PI ? 1 : 0;
  const pt = (r: number, a: number) => `${(C + r * Math.cos(a)).toFixed(2)},${(C + r * Math.sin(a)).toFixed(2)}`;
  return `M${pt(rOut, a0)}A${rOut},${rOut} 0 ${large} 1 ${pt(rOut, a1)}L${pt(R_IN, a1)}A${R_IN},${R_IN} 0 ${large} 0 ${pt(R_IN, a0)}Z`;
}

function DuesDonut({ items, households }: { items: Slice[]; households: number }) {
  const target = useMemo(() => [items.map((i) => i.cur)], [items]);
  const [shown] = useTweenSeries(target);
  const sweepTarget = useMemo(() => [[1]], []);
  const [[sweepIn]] = useTweenSeries(sweepTarget, { duration: 800 });

  const { ref, width, tip, at, show, hide } = useTip();
  const [hot, setHot] = useState<number | null>(null);
  const [pinned, setPinned] = useState<number | null>(null);
  const active = tip?.i ?? hot ?? pinned;

  const total = items.reduce((s, i) => s + i.cur, 0);
  const shownTotal = shown.reduce((s, v) => s + v, 0);
  const share = (v: number) => (total > 0 ? fmtPct(v / total) : '—');

  let angle = -Math.PI / 2;
  const arcs = shown.map((v) => {
    const sweep = shownTotal > 0 ? Math.min((v / shownTotal) * TAU * sweepIn, TAU - 0.001) : 0;
    const a0 = angle;
    angle += sweep;
    const pad = sweep > 0.1 ? 0.012 : 0;
    return { a0: a0 + pad, a1: angle - pad, sweep };
  });

  const focus = active !== null ? items[active] : null;
  const tipItem = items[at.i];
  const upper = at.y < C;

  return (
    <div ref={ref} className="srf-donut">
      <div className="srf-donut-c" style={{ width: SIZE, height: SIZE }}>
        <svg
          width={SIZE}
          height={SIZE}
          viewBox={`0 0 ${SIZE} ${SIZE}`}
          className="srf-svg"
          role="img"
          aria-label={`Dues by kind: ${items.map((i) => `${i.label} ${fmtMoney(i.cur)}`).join('; ')}.`}
        >
          {total === 0 && <circle cx={C} cy={C} r={(R_OUT + R_IN) / 2} fill="none" strokeWidth={R_OUT - R_IN} className="srf-ring" />}
          {arcs.map(
            (arc, i) =>
              arc.sweep > 0.004 && (
                <path
                  key={items[i].id}
                  d={sector(arc.a0, arc.a1, active === i ? R_OUT + 5 : R_OUT)}
                  fill={`var(--srf-cat-${i + 1})`}
                  className={`srf-arc${active !== null && active !== i ? ' dim' : ''}`}
                  onPointerDown={show(i)}
                  onPointerMove={show(i)}
                  onPointerLeave={hide}
                  onClick={() => setPinned(pinned === i ? null : i)}
                />
              ),
          )}
        </svg>
        <div className="srf-hole">
          <span className="srf-hole-k">{focus ? focus.label : 'All dues'}</span>
          <span className="srf-hole-v">
            <Parts parts={moneyParts(focus ? focus.cur : shownTotal)} />
          </span>
          <span className="srf-hole-s">
            {total === 0 ? 'none paid' : focus ? `${share(focus.cur)} of dues` : `from ${households} households`}
          </span>
        </div>
      </div>

      <ul className="srf-legend">
        {items.map((it, i) => (
          <li key={it.id}>
            <button
              type="button"
              aria-pressed={pinned === i}
              title={it.note}
              onClick={() => setPinned(pinned === i ? null : i)}
              onPointerEnter={() => setHot(i)}
              onPointerLeave={() => setHot(null)}
              onFocus={() => setHot(i)}
              onBlur={() => setHot(null)}
              className={`srf-li${active === i ? ' on' : ''}${active !== null && active !== i ? ' dim' : ''}`}
            >
              <span aria-hidden="true" className="srf-li-sw" style={{ background: `var(--srf-cat-${i + 1})` }} />
              <span className="srf-li-name">{it.label}</span>
              <span className="srf-li-val">{fmtMoney(it.cur)}</span>
              <span className="srf-li-pct">{share(it.cur)}</span>
            </button>
          </li>
        ))}
      </ul>

      <p className="srf-sum">
        <span className="srf-summa">Summa {clerkSum(total)}</span>
        The sum as the clerk enters it on the roll.
      </p>

      <ChartTip show={tip !== null} x={at.x} y={upper ? 0 : SIZE} boxWidth={width} width={208} above={upper} center>
        <div className="srf-tip-row">
          <p className="srf-tip-title">{tipItem.label}</p>
          <Delta cur={tipItem.cur} prev={tipItem.prev} />
        </div>
        <p className="srf-tip-note">{tipItem.note}</p>
        <p className="srf-tip-prev">
          Year before <span>{fmtMoney(tipItem.prev)}</span>
        </p>
      </ChartTip>
    </div>
  );
}

function TaskBars({ items }: { items: Slice[] }) {
  const on = useMounted();
  const { ref, width, tip, at, show, hide } = useTip();
  const peak = Math.max(1, ...items.map((i) => Math.max(i.cur, i.prev)));
  const total = items.reduce((s, i) => s + i.cur, 0);
  const roomy = width >= 340;
  const tipItem = items[at.i];

  return (
    <div ref={ref} className="srf-tasks">
      <ul>
        {items.map((t, i) => (
          <li
            key={t.id}
            onPointerDown={show(i)}
            onPointerMove={show(i)}
            onPointerLeave={hide}
            className={`srf-task${tip?.i === i ? ' on' : ''}`}
          >
            <span className="srf-t-name">{t.label}</span>
            <span aria-hidden="true" className="srf-t-bar">
              <span className="srf-t-fill" style={{ width: on ? `${(t.cur / peak) * 100}%` : 0 }} />
              {t.prev > 0 && <span className="srf-t-mark" style={{ left: on ? `calc(${(t.prev / peak) * 100}% - 1px)` : 0 }} />}
            </span>
            <span className="srf-t-nums">
              <span className="srf-t-n">{fmtInt(t.cur)}</span>
              {roomy && <span className="srf-t-d">{signedPct(t.cur, t.prev)}</span>}
            </span>
            <span className="srf-sr">works this period; {fmtInt(t.prev)} in the year before.</span>
          </li>
        ))}
      </ul>
      {total === 0 && <p className="srf-hint">No works were rendered in this period.</p>}

      <ChartTip show={tip !== null} x={at.x} y={at.y - 14} boxWidth={width} above>
        <TipBody item={tipItem} cur={`${fmtInt(tipItem.cur)} works`} prev={`${fmtInt(tipItem.prev)} works`} share={total > 0 ? fmtPct(tipItem.cur / total) : undefined} />
      </ChartTip>
    </div>
  );
}

function GrainBars({ items }: { items: Slice[] }) {
  const on = useMounted();
  const { ref, width, tip, at, show, hide } = useTip();
  const ticks = niceTicks(Math.max(...items.map((i) => Math.max(i.cur, i.prev))), 4);
  const top = ticks[ticks.length - 1];
  const tall = (v: number) => (on ? `${Math.max(v > 0 ? 1.2 : 0, (v / top) * 100)}%` : '0%');
  const tipItem = items[at.i];

  return (
    <div ref={ref} className="srf-grain">
      <div className="srf-g-plot">
        {ticks.map((t) => (
          <div key={t} aria-hidden="true" className="srf-g-tick" style={{ bottom: `${(t / top) * 100}%` }}>
            <span className={`srf-g-lab${t === 0 ? ' zero' : ''}`}>{fmtInt(t)}</span>
            <span className={`srf-g-line${t === 0 ? ' zero' : ''}`} />
          </div>
        ))}
        <ul className="srf-g-cols">
          {items.map((c, i) => (
            <li
              key={c.id}
              onPointerDown={show(i)}
              onPointerMove={show(i)}
              onPointerLeave={hide}
              className={`srf-g-col${tip?.i === i ? ' on' : ''}`}
            >
              <span aria-hidden="true" className="srf-g-bar cur" style={{ height: tall(c.cur) }} />
              <span aria-hidden="true" className="srf-g-bar prev" style={{ height: tall(c.prev) }} />
              <span className="srf-sr">
                {c.label}: {fmtInt(c.cur)} bushels this period, {fmtInt(c.prev)} in the year before.
              </span>
            </li>
          ))}
        </ul>
      </div>
      <ul aria-hidden="true" className="srf-g-labels">
        {items.map((c) => (
          <li key={c.id} className="srf-g-label">
            {c.label}
          </li>
        ))}
      </ul>

      <ChartTip show={tip !== null} x={at.x} y={at.y - 14} boxWidth={width} above>
        <TipBody item={tipItem} cur={`${fmtInt(tipItem.cur)} bu`} prev={`${fmtInt(tipItem.prev)} bu`} />
      </ChartTip>
    </div>
  );
}

type SortKey = 'name' | 'tenure' | 'acres' | 'done' | 'rate' | 'dues' | 'grain' | 'status';

const COLUMNS: { key: SortKey; label: string; right?: boolean; first: 1 | -1 }[] = [
  { key: 'name', label: 'Tenant', first: 1 },
  { key: 'tenure', label: 'Holding', first: 1 },
  { key: 'acres', label: 'Acres', right: true, first: -1 },
  { key: 'done', label: 'Works', right: true, first: -1 },
  { key: 'rate', label: 'Rendered', first: 1 },
  { key: 'dues', label: 'Dues paid', right: true, first: -1 },
  { key: 'grain', label: 'Grain milled', right: true, first: -1 },
  { key: 'status', label: 'Standing', first: 1 },
];

const STATUS: Record<Status, { label: string; tone: string }> = {
  ok: { label: 'Up to date', tone: 'ok' },
  behind: { label: 'Behind', tone: 'behind' },
  default: { label: 'In default', tone: 'bad' },
  none: { label: 'No works due', tone: 'none' },
};

const STATUS_ORDER: Record<Status, number> = { default: 0, behind: 1, ok: 2, none: 3 };
const STATUS_FILTERS: ('all' | Status)[] = ['all', 'ok', 'behind', 'default'];
const PAGE = 10;

function compare(a: TenantRow, b: TenantRow, key: SortKey): number {
  switch (key) {
    case 'name':
      return a.name.localeCompare(b.name);
    case 'tenure':
      return a.tenure - b.tenure || b.acres - a.acres;
    case 'status':
      return STATUS_ORDER[a.status] - STATUS_ORDER[b.status] || (a.rate ?? 1) - (b.rate ?? 1);
    case 'rate':
      return (a.rate ?? 0) - (b.rate ?? 0);
    default:
      return a[key] - b[key];
  }
}

function SortGlyph({ dir }: { dir: 1 | -1 | 0 }) {
  return (
    <svg viewBox="0 0 8 12" className="srf-glyph" aria-hidden="true">
      <path d="M4 1 7 5H1Z" className={dir === 1 ? 'on' : ''} />
      <path d="M4 11 1 7h6Z" className={dir === -1 ? 'on' : ''} />
    </svg>
  );
}

function TenantTable({ rows }: { rows: TenantRow[] }) {
  const [sort, setSort] = useState<{ key: SortKey; dir: 1 | -1 }>({ key: 'rate', dir: 1 });
  const [query, setQuery] = useState('');
  const [status, setStatus] = useState<'all' | Status>('all');
  const [page, setPage] = useState(0);

  const q = query.trim().toLowerCase();
  const matched = useMemo(
    () => (q ? rows.filter((r) => `${r.name} ${r.end} ${TENURES[r.tenure].one}`.toLowerCase().includes(q)) : rows),
    [rows, q],
  );

  const counts = useMemo(() => {
    const c: Record<string, number> = { all: matched.length, ok: 0, behind: 0, default: 0, none: 0 };
    for (const r of matched) c[r.status]++;
    return c;
  }, [matched]);

  const sorted = useMemo(() => {
    const list = status === 'all' ? [...matched] : matched.filter((r) => r.status === status);
    return list.sort((a, b) => {
      if (sort.key === 'rate' && (a.rate === null) !== (b.rate === null)) return a.rate === null ? 1 : -1;
      return compare(a, b, sort.key) * sort.dir || a.name.localeCompare(b.name);
    });
  }, [matched, status, sort]);

  const pages = Math.max(1, Math.ceil(sorted.length / PAGE));
  const current = Math.min(page, pages - 1);
  const visible = sorted.slice(current * PAGE, current * PAGE + PAGE);
  const filtered = q !== '' || status !== 'all';

  const sortBy = (key: SortKey, first: 1 | -1) => {
    setSort((s) => (s.key === key ? { key, dir: s.dir === 1 ? -1 : 1 } : { key, dir: first }));
    setPage(0);
  };

  return (
    <section className="srf-card srf-reveal srf-table-card" style={{ '--i': 8 } as CSSProperties}>
      <div className="srf-t-toolbar">
        <header className="srf-chead">
          <div>
            <h2 className="srf-ctitle">Tenants</h2>
            <p className="srf-csub">Each household’s standing for the chosen period. Choose a column heading to sort by it.</p>
          </div>
        </header>
        <div className="srf-t-tools">
          <label className="srf-search">
            <span className="srf-sr">Find a tenant by name, holding or end of the village</span>
            <SearchIcon />
            <input
              type="search"
              value={query}
              onChange={(e) => {
                setQuery(e.target.value);
                setPage(0);
              }}
              placeholder="Find a tenant"
            />
          </label>
          <div className="srf-xscroll">
            <div role="group" aria-label="Standing" className="srf-seg">
              {STATUS_FILTERS.map((s) => (
                <button
                  key={s}
                  type="button"
                  aria-pressed={status === s}
                  onClick={() => {
                    setStatus(s);
                    setPage(0);
                  }}
                >
                  {s === 'all' ? 'All' : STATUS[s].label}
                  <span className="srf-chip-n">{counts[s]}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div className="srf-t-wrap">
        <table className="srf-table">
          <caption className="srf-sr">
            Tenants in view, with holding, works rendered, dues paid, grain milled and standing for the chosen period
          </caption>
          <thead>
            <tr>
              {COLUMNS.map((c, i) => {
                const active = sort.key === c.key;
                return (
                  <th
                    key={c.key}
                    scope="col"
                    aria-sort={active ? (sort.dir === 1 ? 'ascending' : 'descending') : 'none'}
                    className={`srf-th${c.right ? ' r' : ''}${i === 0 ? ' c1' : ''}${i === COLUMNS.length - 1 ? ' cl' : ''}`}
                  >
                    <button type="button" onClick={() => sortBy(c.key, c.first)} className={`srf-sort${active ? ' on' : ''}${c.right ? ' r' : ''}`}>
                      {c.label}
                      <SortGlyph dir={active ? sort.dir : 0} />
                    </button>
                  </th>
                );
              })}
            </tr>
          </thead>
          <tbody>
            {visible.map((r) => (
              <tr key={r.id}>
                <th scope="row" className="srf-cell-name">
                  <span className="srf-name-t">{r.name}</span>
                  <span className="srf-end">{r.end}</span>
                </th>
                <td className="srf-td">{TENURES[r.tenure].one}</td>
                <td className="srf-td r num">{r.acres}</td>
                <td className="srf-td r">
                  {r.owed > 0 ? (
                    <>
                      <span className="srf-strong">{r.done}</span>
                      <span className="srf-dim"> / {r.owed}</span>
                    </>
                  ) : (
                    <span className="srf-dim">—</span>
                  )}
                </td>
                <td className="srf-td">
                  {r.rate === null ? (
                    <span className="srf-dim">—</span>
                  ) : (
                    <span className="srf-rate">
                      <span aria-hidden="true" className="srf-r-bar">
                        <span className={`srf-r-fill ${STATUS[r.status].tone}`} style={{ width: `${r.rate * 100}%` }} />
                      </span>
                      <span className="srf-r-n">{Math.round(r.rate * 100)}%</span>
                    </span>
                  )}
                </td>
                <td className="srf-td r num">{fmtMoney(r.dues)}</td>
                <td className="srf-td r">
                  {r.grain}
                  <span className="srf-dim"> bu</span>
                </td>
                <td className="srf-td cl">
                  <span className="srf-stand">
                    <span aria-hidden="true" className={`srf-dot ${STATUS[r.status].tone}`} />
                    {STATUS[r.status].label}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        {sorted.length === 0 && (
          <div className="srf-empty-box">
            <p className="srf-empty-t">No tenant answers to that</p>
            <p className="srf-empty-s">
              {filtered
                ? 'Nothing matches the search and standing you chose. Clear them to see every household in view.'
                : 'No households fall within the filters above.'}
            </p>
            {filtered && (
              <button
                type="button"
                onClick={() => {
                  setQuery('');
                  setStatus('all');
                  setPage(0);
                }}
                className="srf-clear"
              >
                Clear search and standing
              </button>
            )}
          </div>
        )}
      </div>

      <div className="srf-t-foot">
        <p className="srf-count" aria-live="polite">
          {sorted.length === 0
            ? 'No households'
            : `${current * PAGE + 1}–${current * PAGE + visible.length} of ${sorted.length} ${sorted.length === 1 ? 'household' : 'households'}`}
        </p>
        <div className="srf-pages">
          <span className="srf-page-n">
            Page {current + 1} of {pages}
          </span>
          <button type="button" disabled={current === 0} onClick={() => setPage(current - 1)} className="srf-pager">
            Previous
          </button>
          <button type="button" disabled={current >= pages - 1} onClick={() => setPage(current + 1)} className="srf-pager">
            Next
          </button>
        </div>
      </div>
    </section>
  );
}

const EVERYONE = TENURES.map((_, i) => i);
const order = (i: number) => ({ '--i': i }) as CSSProperties;

function ThemeSwitch({ theme, onChange }: { theme: Theme; onChange: (t: Theme) => void }) {
  const options = [
    { id: 'light', label: 'Day theme', text: 'Day', Icon: SunIcon },
    { id: 'dark', label: 'Night theme', text: 'Night', Icon: MoonIcon },
  ] as const;
  return (
    <div role="group" aria-label="Colour theme" className="srf-seg srf-theme">
      {options.map(({ id, label, text, Icon }) => (
        <button key={id} type="button" aria-pressed={theme === id} aria-label={label} onClick={() => onChange(id)}>
          <Icon />
          <span className="srf-lbl">{text}</span>
        </button>
      ))}
    </div>
  );
}

function Lede({ view }: { view: View }) {
  const { owed, totals, rows, days, to, tasks } = view;
  const until = fmtDay(to, { year: true });
  const lead = days === YEAR_DAYS ? 'Across the whole year' : `In the ${days} days to ${until}`;
  const n = rows.length;

  if (owed.cur === 0) {
    return (
      <>
        {lead}, no works fell due from these {n} households. They paid <b>{fmtMoney(totals.dues.cur)}</b> in dues and
        brought <b>{fmtGrainShort(totals.grain.cur)}</b> of corn to the mill.
      </>
    );
  }

  const inDefault = rows.filter((r) => r.status === 'default').length;
  const busiest = tasks.reduce((a, b) => (b.cur > a.cur ? b : a));
  return (
    <>
      {lead}, {n} households rendered <b>{fmtInt(totals.works.cur)}</b> of the <b>{fmtInt(owed.cur)}</b> works they owed
      ({fmtPct(totals.works.cur / owed.cur)}). {busiest.label} took the most labour, and{' '}
      {inDefault === 0 ? 'no household is' : inDefault === 1 ? 'one household is' : `${inDefault} households are`} in
      default.
    </>
  );
}

const fmtGrainShort = (bushels: number): string =>
  grainParts(bushels)
    .map((p) => `${p.n} ${p.u}`)
    .join(' ');

export default function SerfDashboard() {
  const [theme, setTheme] = useTheme();
  const [range, setRange] = useState({ from: FIRST_DAY, to: LAST_DAY });
  const [segs, setSegs] = useState<number[]>([]);
  const [metric, setMetric] = useState<MetricId>('works');

  const inView = useMemo(() => (segs.length ? segs : EVERYONE), [segs]);
  const view = useMemo(() => buildView(range.from, range.to, inView), [range, inView]);
  const shape = useMemo(() => yearShape(metric, inView), [metric, inView]);
  const onRange = useCallback((from: number, to: number) => setRange({ from, to }), []);

  const settled = useDebounced(view, 700);

  const panel = useRef<HTMLDivElement>(null);
  const [pinned, setPinned] = useState(false);
  useEffect(() => {
    const el = panel.current;
    if (!el) return;
    const io = new IntersectionObserver(([entry]) => setPinned(!entry.isIntersecting && entry.boundingClientRect.top < 0));
    io.observe(el);
    return () => io.disconnect();
  }, []);

  const cfg = METRICS[metric];

  return (
    <div className="srf">
      <header className="srf-top">
        <div className="srf-top-in">
          <div className="srf-brand">
            <span className="srf-logo">
              <TallyMark />
            </span>
            <span className="srf-name">Serf</span>
            <span aria-hidden="true" className="srf-vr" />
            <span className="srf-tag">The reeve’s account</span>
          </div>
          <ThemeSwitch theme={theme} onChange={setTheme} />
        </div>
      </header>

      {pinned && <SlimFilters from={range.from} to={range.to} segs={segs} onRange={onRange} onSegs={setSegs} />}

      <main className="srf-main">
        <div className="srf-reveal" style={order(0)}>
          <p className="srf-eyebrow">
            Account as of <time dateTime={TODAY_ISO}>{fmtDay(LAST_DAY, { year: true })}</time>
          </p>
          <h1 className="srf-h1">Manor of Elmswick</h1>
          <p aria-hidden="true" className="srf-lede">
            <Lede view={view} />
          </p>
          <p className="srf-sr" aria-live="polite">
            <Lede view={settled} />
          </p>
        </div>

        <div className="srf-panel" ref={panel}>
          <FilterPanel from={range.from} to={range.to} segs={segs} shape={shape} onRange={onRange} onSegs={setSegs} />
        </div>

        <KpiRow view={view} metric={metric} onSelect={setMetric} />

        <section className="srf-card srf-pad srf-reveal srf-trend-card" style={order(6)}>
          <header className="srf-chead">
            <div>
              <h2 className="srf-ctitle">{cfg.chart}</h2>
              <p className="srf-csub">Each point totals the seven days before it. Choose another figure above to chart it.</p>
            </div>
            <YearKey kind="line" />
          </header>
          <TrendChart metric={metric} cur={view.rolling[metric].cur} prev={view.rolling[metric].prev} from={view.from} />
        </section>

        <div className="srf-cards3">
          <section className="srf-card srf-pad srf-reveal srf-col" style={order(7)}>
            <header className="srf-chead">
              <div>
                <h2 className="srf-ctitle">Dues by kind</h2>
                <p className="srf-csub">Money paid to the lord. Choose a kind to hold it in view.</p>
              </div>
            </header>
            <DuesDonut items={view.dues} households={view.rows.length} />
          </section>

          <section className="srf-card srf-pad srf-reveal srf-col" style={order(7)}>
            <header className="srf-chead">
              <div>
                <h2 className="srf-ctitle">Works by task</h2>
                <p className="srf-csub">Days of labour on the lord’s demesne.</p>
              </div>
              <YearKey kind="mark" />
            </header>
            <TaskBars items={view.tasks} />
          </section>

          <section className="srf-card srf-pad srf-reveal srf-col srf-grain-card" style={order(7)}>
            <header className="srf-chead">
              <div>
                <h2 className="srf-ctitle">Grain by kind</h2>
                <p className="srf-csub">Bushels ground at the lord’s mill.</p>
              </div>
              <YearKey />
            </header>
            <GrainBars items={view.crops} />
          </section>
        </div>

        <TenantTable rows={view.rows} />

        <footer className="srf-note">
          <p>
            Sample figures, invented for a manor that never was. A work is one day’s labour owed on the lord’s demesne.
            Money is reckoned at four farthings to the penny, 12d to the shilling and 20s to the pound; grain at eight
            bushels to the quarter. Each figure is compared with the same dates one year earlier.
          </p>
        </footer>
      </main>
    </div>
  );
}


