function Parts({ parts }: { parts: Part[] }) {
  return (
    <>
      {parts.map((p, i) => (
        <span key={i}>
          {i > 0 && ' '}
          <span className="srf-nowrap">
            {p.n}
            {p.u && <span className={p.gap ? 'srf-u srf-u-gap' : 'srf-u'}>{p.u}</span>}
          </span>
        </span>
      ))}
    </>
  );
}

function Delta({ cur, prev, invert = false }: { cur: number; prev: number; invert?: boolean }) {
  if (!(prev > 0)) {
    return (
      <span className="srf-delta srf-muted">
        —<span className="srf-sr">nothing to compare in the year before</span>
      </span>
    );
  }
  const change = (cur - prev) / prev;
  if (Math.abs(change) < 0.005) {
    return (
      <span className="srf-delta srf-muted">
        Level<span className="srf-sr"> with the year before</span>
      </span>
    );
  }
  const up = change > 0;
  return (
    <span className={`srf-delta ${up !== invert ? 'srf-good' : 'srf-bad'}`}>
      <ArrowIcon up={up} />
      {fmtPct(change)}
      <span className="srf-sr">{up ? ' up' : ' down'} on the year before</span>
    </span>
  );
}

function ChartTip({
  show,
  x,
  y,
  boxWidth,
  width = 216,
  above = false,
  center = false,
  children,
}: {
  show: boolean;
  x: number;
  y: number;
  boxWidth: number;
  width?: number;
  above?: boolean;
  center?: boolean;
  children: ReactNode;
}) {
  const wasShown = useRef(false);
  const glide = show && wasShown.current;
  useEffect(() => {
    wasShown.current = show;
  }, [show]);

  const preferred = center ? x - width / 2 : x + 14 + width > boxWidth ? x - 14 - width : x + 14;
  const left = Math.round(Math.max(0, Math.min(preferred, boxWidth - width)));
  return (
    <div
      aria-hidden="true"
      className={`srf-tip${glide ? ' glide' : ''}${show ? ' show' : ''}`}
      style={{ width, transform: `translate(${left}px, ${Math.round(y)}px)${above ? ' translateY(-100%)' : ''}` }}
    >
      {children}
    </div>
  );
}

function YearKey({ kind = 'bar' }: { kind?: 'bar' | 'line' | 'mark' }) {
