type Status = 'ok' | 'behind' | 'default' | 'none';

interface Pair {
  cur: number;
  prev: number;
}

interface Slice extends Pair {
  id: number;
  label: string;
  note: string;
}

interface TenantRow {
  id: number;
  name: string;
  end: string;
  tenure: number;
  acres: number;
  owed: number;
  done: number;
  rate: number | null;
  dues: number;
  grain: number;
  status: Status;
}

interface View {
  from: number;
  to: number;
  days: number;
  totals: Record<MetricId, Pair>;
  owed: Pair;
  rolling: Record<MetricId, { cur: number[]; prev: number[] }>;
  tasks: Slice[];
  dues: Slice[];
  crops: Slice[];
  rows: TenantRow[];
}

const STORE: Record<MetricId, Int32Array[]> = { works: S.done, missed: S.missed, dues: S.dues, grain: S.grain };

function rolling(metric: MetricId, segs: number[], from: number, to: number, yearBefore: boolean): number[] {
  const stores = segs.map((s) => STORE[metric][s]);
  const out = new Array<number>(to - from + 1);
  for (let d = from; d <= to; d++) {
    const end = yearBefore ? TWIN[d] : d;
    let v = 0;
    for (const p of stores) v += p[end + 1] - p[end - 6];
    out[d - from] = v;
  }
  return out;
}

const yearShape = (metric: MetricId, segs: number[]): number[] => rolling(metric, segs, FIRST_DAY, LAST_DAY, false);

function buildView(from: number, to: number, segs: number[]): View {
  const pFrom = TWIN[from];
  const pTo = TWIN[to];

  const total = (stores: Int32Array[]): Pair => {
    let cur = 0;
    let prev = 0;
    for (const s of segs) {
      cur += span(stores[s], from, to);
      prev += span(stores[s], pFrom, pTo);
    }
    return { cur, prev };
  };

  const slices = (labels: readonly { label: string; note: string }[], stores: Int32Array[][]): Slice[] =>
    labels.map((l, k) => {
      let cur = 0;
      let prev = 0;
      for (const s of segs) {
        cur += span(stores[s][k], from, to);
        prev += span(stores[s][k], pFrom, pTo);
      }
      return { id: k, label: l.label, note: l.note, cur, prev };
    });

  const rows: TenantRow[] = HOUSEHOLDS.filter((h) => segs.includes(h.tenure)).map((h) => {
    const owed = span(H.owed[h.id], from, to);
    const done = span(H.done[h.id], from, to);
    const rate = owed > 0 ? done / owed : null;
    const status: Status = rate === null ? 'none' : rate >= 0.95 ? 'ok' : rate >= 0.85 ? 'behind' : 'default';
    return {
      id: h.id,
      name: h.name,
      end: h.end,
      tenure: h.tenure,
      acres: h.acres,
      owed,
      done,
      rate,
      dues: span(H.dues[h.id], from, to),
      grain: span(H.grain[h.id], from, to),
      status,
    };
  });

  const both = (m: MetricId) => ({ cur: rolling(m, segs, from, to, false), prev: rolling(m, segs, from, to, true) });

  return {
    from,
    to,
    days: to - from + 1,
    totals: { works: total(S.done), missed: total(S.missed), dues: total(S.dues), grain: total(S.grain) },
    owed: total(S.owed),
    rolling: { works: both('works'), missed: both('missed'), dues: both('dues'), grain: both('grain') },
    tasks: slices(TASKS, S.task),
    dues: slices(DUES, S.due),
    crops: slices(CROPS, S.crop),
    rows,
  };
}

